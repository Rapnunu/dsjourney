# Neon PostgreSQL (required)
DATABASE_URL=

# Neon Auth (required for login)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Public site URL (recommended in production for SEO / canonical links)
# NEXT_PUBLIC_SITE_URL=https://dsjourney.vercel.app

# Support email shown on legal/contact pages
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# Preview / local only — optional demo sign-in helper (never set in production)
# TEST_ACCOUNT_EMAIL=
# TEST_ACCOUNT_PASSWORD=
